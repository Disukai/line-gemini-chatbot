# ==========================================
# LINE Messaging API Configuration
# ==========================================
# Get these from https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN="YOUR_LINE_CHANNEL_ACCESS_TOKEN_HERE"
LINE_CHANNEL_SECRET="YOUR_LINE_CHANNEL_SECRET_HERE"

# ==========================================
# Google Gemini API Configuration
# ==========================================
# Get this free from https://aistudio.google.com/
GEMINI_API_KEY="AQ.Ab8RN6Lrg9f6INRqOaRgPZfHhHvO6QURNN6A5AcOL2q7e-YSWQ"
GEMINI_MODEL="gemini-3.8-flash"

# ==========================================
# Bot Personality & Group Settings
# ==========================================
BOT_NAME="จิมมี่"
BOT_NICKNAMES_STR="บอท,จิมมี่,เจมี่,gemini,ai,เพื่อน"

# Default Persona style:
# - friend  : เพื่อนซี้ เฮฮา กวนๆ คุยสนุก รู้ลึก (แนะนำสำหรับกลุ่มไลน์เพื่อน)
# - chill   : สายชิลล์ ปล่อยจอย คูลๆ อารมณ์ดี
# - expert  : เพื่อนสายเนิร์ด มือโปร วิเคราะห์ขาด
# - snarky  : สายกวน ขี้แซว มุกหน้าตาย
DEFAULT_PERSONA="friend"

# Group Trigger Mode:
# - mention : ตอบเฉพาะเมื่อถูกแท็ก @ชื่อ, มีชื่อบอทในประโยค, ตอบกลับแชทของบอท, หรือใช้คำสั่ง / (แนะนำ ป้องกันการสแปมกลุ่ม)
# - smart   : mention + ช่วยตอบเมื่อเพื่อนถามคำถามในกลุ่ม
# - all     : ตอบทุกข้อความในกลุ่ม (ไม่แนะนำถ้ากลุ่มคุยเยอะ)
GROUP_TRIGGER_MODE="mention"

# Maximum recent group messages to keep as context memory
MAX_HISTORY_PER_GROUP=25

# Show '...' loading animation in LINE while generating reply
ENABLE_LOADING_ANIMATION=true

# Server Port
HOST="0.0.0.0"
PORT=8000
DEBUG=false
